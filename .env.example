# MongoDB
MONGODB_URI=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_ID=
GOOGLE_SECRET=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Suma Impacto — API pública lite (solo servidor; no usar NEXT_PUBLIC_ para la key)
SUMA_IMPACTO_BASE_URL=
SUMA_IMPACTO_EXPERIENCES_API_KEY=replace-with-secure-32-plus-char-key
SUMA_IMPACTO_DEMOINN_ORG_ID=replace-with-24-char-mongo-object-id
# Opcional; por defecto: demoinn
SUMA_IMPACTO_EXPERIENCES_SOURCE=
# Opcional; timeout del fetch en ms (default: 8000, rango: 1000–30000)
SUMA_IMPACTO_API_TIMEOUT_MS=
# Opcional; TTL del cache ISR en segundos (default: 1800, rango: 60–3600)
SUMA_IMPACTO_API_CACHE_TTL_SECONDS=
